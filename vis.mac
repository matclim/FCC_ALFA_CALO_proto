# Geant4 visualisation macro for the GRAiNITA PoC module.
#
#   ddsim --compactFile GrainitaModule.xml --runType vis --macroFile vis.mac \
#         --enableGun --gun.particle gamma --gun.energy "10*GeV" \
#         --gun.direction "0 0 1" --gun.position "0 0 -25*cm"
#
# Needs an X connection (ssh -Y lxplus.cern.ch). If that is too slow, see
# the offscreen section at the bottom.

/vis/verbose warnings

# ---- viewer -------------------------------------------------------------
/vis/open OGL 1000x800-0+0
/vis/viewer/set/autoRefresh false

/vis/drawVolume
/vis/viewer/set/viewpointThetaPhi 75 15
/vis/viewer/set/style surface
/vis/viewer/set/hiddenMarker true
/vis/viewer/zoom 1.4

# The Grainita block is opaque by default, which hides everything inside.
# Make it transparent so showers and fibres are visible.
/vis/geometry/set/colour GrainitaEcal_active 0 0.2 0.55 0.75 0.15
/vis/geometry/set/colour GrainitaEcal_fibre  0 0.95 0.85 0.2 1.0

# ---- scale and axes -----------------------------------------------------
/vis/scene/add/axes 0 0 -25 5 cm
/vis/scene/add/scale 10 cm z 1 0 0 manual 0 -10 0 cm

# ---- trajectories -------------------------------------------------------
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts false
/vis/modeling/trajectories/drawByCharge-0/set 1  red      # positive
/vis/modeling/trajectories/drawByCharge-0/set -1 blue     # negative
/vis/modeling/trajectories/drawByCharge-0/set 0  green    # neutral

# Showers contain thousands of tracks. Suppress the very low energy ones or
# the display becomes an unreadable green fog.
/vis/filtering/trajectories/create/attributeFilter
/vis/filtering/trajectories/attributeFilter-0/setAttribute IKE
/vis/filtering/trajectories/attributeFilter-0/addInterval 10 MeV 1e6 MeV

/vis/scene/add/hits

# Accumulate a few events so you can see the shower envelope.
/vis/scene/endOfEventAction accumulate 5

/vis/viewer/set/autoRefresh true
/vis/viewer/flush

# ---------------------------------------------------------------------------
# OFFSCREEN ALTERNATIVE (no X connection)
#
# Replace the "/vis/open OGL ..." line above with one of these, run, then
# scp the resulting file back to your laptop:
#
#   /vis/open TOOLSSG_OFFSCREEN 1200x900     -> writes g4tools PNG files
#   /vis/open VRML2FILE                      -> g4_00.wrl, open in any VRML viewer
#   /vis/open HepRepFile                     -> G4Data0.heprep, needs HepRApp
#
# TOOLSSG_OFFSCREEN is the least painful if your Geant4 has it (11.x).
# Check with: /vis/list
# ---------------------------------------------------------------------------
